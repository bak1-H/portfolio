---
import Layout from '../layouts/Layout.astro';
import Proyectos from '../components/Proyectos.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Divider from '../components/Divider.astro';
import dividerProjects from '../assets/img/illustrations/divider-projects.png';
import dividerContact from '../assets/img/illustrations/divider-contact.png';
---

<Layout>
  <main>
    <About />
    <Divider
      image={dividerProjects}
      alt="Un gato negro camina por un sendero entre flores al atardecer"
      statement="Software pensado para quien lo usa cada día."
    />
    <Proyectos />
    <Divider
      image={dividerContact}
      alt="Un gato negro duerme bajo un cerezo en flor al caer la tarde"
      statement="Si tienes una idea, conversemos."
    />
    <Contact />
  </main>
</Layout>
