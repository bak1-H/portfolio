---
import new_foto from '../assets/img/new_foto.png';

const techs = [
  { name: 'React',       color: '#61dafb' },
  { name: 'Node.js',     color: '#8cc84b' },
  { name: 'Tailwind',    color: '#38bdf8' },
  { name: 'Spring Boot', color: '#3fb950' },
  { name: 'HTML / CSS',  color: '#f85149' },
  { name: 'SQL / NoSQL', color: '#54a2ff' },
  { name: 'Git',         color: '#d29922' },
  { name: 'Python',      color: '#53fc44' },
  { name: 'Photoshop',   color: '#5cd9f7' },
];
---

<section id="sobre-mi" class="pt-28 pb-16 px-6">
  <div class="max-w-[820px] mx-auto">

    <div class="flex flex-col sm:flex-row gap-6 items-start reveal">
      <img
        src={new_foto.src}
        alt="Foto de perfil de Maximiliano Huerta"
        decoding="async"
        class="w-20 h-20 rounded-2xl object-cover ring-1 ring-[var(--c-border-md)] shrink-0"
      />
      <div class="flex-1">
        <h1 class="text-2xl font-semibold tracking-tight text-[var(--c-text)]">bak1-h</h1>
        <p class="text-[var(--c-accent)] text-sm font-medium mt-0.5">Analista Programador · Desarrollador de Software</p>
        <p class="text-[var(--c-muted)] text-[15px] leading-relaxed mt-4">
          Estudiante de Informática con pasión por el desarrollo de software. Me encanta aprender
          nuevas tecnologías y enfrentar desafíos para crecer como desarrollador. Actualmente busco
          oportunidades para aplicar mis conocimientos en proyectos reales y ganar experiencia práctica.
        </p>
      </div>
    </div>

    <div class="mt-10 reveal" style="--reveal-delay: 0.05s">
      <p class="mono text-xs text-[var(--c-faint)] mb-3">
        <span class="text-[var(--c-accent)]">#</span> tecnologías utilizadas
      </p>
      <div class="marquee">
        <div class="marquee-track">
          {[0, 1].map((dup) => (
            <ul class="marquee-group" aria-hidden={dup === 1 ? 'true' : undefined}>
              {techs.map((t) => (
                <li class="inline-flex items-center gap-2 px-3 py-1.5 bg-[var(--c-surface)] border border-[var(--c-border)] rounded-full text-xs text-[var(--c-chip)] whitespace-nowrap">
                  <span class="dot" style={`background:${t.color}`}></span>
                  {t.name}
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>
