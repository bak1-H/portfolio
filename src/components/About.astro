---
import new_foto from '../assets/img/new_foto.png';

const techs = [
  { name: 'React',       color: '#61dafb' },
  { name: 'Node.js',     color: '#8cc84b' },
  { name: 'Tailwind',    color: '#38bdf8' },
  { name: 'Spring Boot', color: '#3fb950' },
  { name: 'HTML / CSS',  color: '#f85149' },
  { name: 'SQL / NoSQL', color: '#54a2ff' },
  { name: 'Git',         color: '#d29922' },
  { name: 'Python',      color: '#53fc44' },
  { name: 'Photoshop',   color: '#5cd9f7' },
];
---

<section id="sobre-mi" class="pt-28 pb-16 px-6">
  <div class="max-w-[820px] mx-auto">

    <!-- Status badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-[var(--c-surface)] border border-[var(--c-border)] rounded-full text-xs text-[var(--c-muted)] mb-7 reveal">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
      Disponible para trabajar
    </div>

    <!-- Hero: photo + info -->
    <div class="flex flex-col sm:flex-row gap-6 items-start reveal" style="--reveal-delay: 0.04s">
      <img
        src={new_foto.src}
        alt="Foto de perfil de Maximiliano Huerta"
        decoding="async"
        class="w-24 h-24 rounded-2xl object-cover ring-2 ring-[var(--c-accent-ring)] shrink-0"
      />
      <div class="flex-1">
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-[var(--c-text)] leading-[1.1]">
          bak1-h
        </h1>
        <p class="text-[var(--c-accent)] text-sm font-medium mt-2">
          Analista Programador · Desarrollador de Software
        </p>
        <p class="text-[var(--c-muted)] text-[15px] leading-relaxed mt-4 max-w-[520px]">
          Estudiante de Informática con pasión por el desarrollo de software. Me encanta aprender
          nuevas tecnologías y enfrentar desafíos para crecer como desarrollador. Actualmente busco
          oportunidades para aplicar mis conocimientos en proyectos reales y ganar experiencia práctica.
        </p>

        <!-- Social links -->
        <div class="flex items-center gap-2 mt-5">
          <a
            href="https://github.com/bak1-H"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Ver perfil de GitHub"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-[var(--c-muted)] border border-[var(--c-border-md)] rounded-lg hover:text-[var(--c-text)] hover:border-[var(--c-border-hover)] transition-all duration-300"
          >
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            GitHub
          </a>
          <a
            href="https://www.linkedin.com/in/maximiliano-huerta-gonzalez-b488922b3/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Ver perfil de LinkedIn"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-[var(--c-muted)] border border-[var(--c-border-md)] rounded-lg hover:text-[var(--c-text)] hover:border-[var(--c-border-hover)] transition-all duration-300"
          >
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            LinkedIn
          </a>
        </div>
      </div>
    </div>

    <!-- Tech marquee -->
    <div class="mt-12 reveal" style="--reveal-delay: 0.08s">
      <p class="mono text-xs text-[var(--c-faint)] mb-3">
        <span class="text-[var(--c-accent)]">#</span> tecnologías utilizadas
      </p>
      <div class="marquee">
        <div class="marquee-track">
          {[0, 1].map((dup) => (
            <ul class="marquee-group" aria-hidden={dup === 1 ? 'true' : undefined}>
              {techs.map((t) => (
                <li class="inline-flex items-center gap-2 px-3 py-1.5 bg-[var(--c-surface)] border border-[var(--c-border)] rounded-full text-xs text-[var(--c-chip)] whitespace-nowrap">
                  <span class="dot" style={`background:${t.color}`}></span>
                  {t.name}
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>
