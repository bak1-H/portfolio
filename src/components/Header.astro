---
import Arrow from './Arrow.astro';
---

<header class="nav-shell">
  <nav class="nav-pill" aria-label="Principal">
    <a href="#sobre-mi" class="nav-brand">(❁´◡`❁)</a>

    <ul class="nav-links">
      <li><a href="#sobre-mi">Sobre mí</a></li>
      <li><a href="#tecnologias">Tecnologías</a></li>
      <li><a href="#proyectos">Proyectos</a></li>
    </ul>

    <a href="#contacto" class="btn btn-cta btn-sm nav-cta">Contacto<Arrow /></a>

    <button
      id="navToggle"
      class="nav-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="navMenu"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <path d="M4 8h16M4 16h16" />
      </svg>
    </button>
  </nav>

  <div id="navMenu" class="nav-menu" hidden>
    <ul>
      <li><a href="#sobre-mi">Sobre mí</a></li>
      <li><a href="#tecnologias">Tecnologías</a></li>
      <li><a href="#proyectos">Proyectos</a></li>
    </ul>
    <a href="#contacto" class="btn btn-cta">Contacto<Arrow /></a>
  </div>
</header>

<script>
  const toggle = document.getElementById('navToggle');
  const menu = document.getElementById('navMenu');

  function setMenuOpen(isOpen: boolean) {
    if (!toggle || !menu) return;
    menu.hidden = !isOpen;
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
  }

  toggle?.addEventListener('click', () => setMenuOpen(menu?.hidden ?? false));
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenuOpen(false);
  });
</script>
